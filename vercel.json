{
  "version": 2,
  "builds": [
    {
      "src": "app/frontend/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    },
    {
      "src": "app/backend/api/index.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/app/backend/api/index.ts" },
    { "src": "/health",   "dest": "/app/backend/api/index.ts" },
    { "handle": "filesystem" },
    { "src": "/(.*)",     "dest": "/index.html" }
  ],
  "env": {
    "VERCEL": "1"
  }
}
