{
  "version": 2,
  "buildCommand": "cd app/frontend && npm install && npm run build && cd ../backend && npm install",
  "outputDirectory": "app/frontend/dist",
  "functions": {
    "app/backend/api/index.ts": {
      "memory": 512,
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/app/backend/api/index" },
    { "source": "/health",     "destination": "/app/backend/api/index" },
    { "source": "/:path*",     "destination": "/index.html" }
  ],
  "env": {
    "VERCEL": "1"
  }
}
