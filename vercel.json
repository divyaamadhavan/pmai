{
  "version": 2,
  "buildCommand": "cd app/backend && npm install && npm run build",
  "outputDirectory": "app/frontend/dist",
  "functions": {
    "api/index.ts": {
      "memory": 512,
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/health",     "destination": "/api/index" },
    { "source": "/:path*",     "destination": "/index.html" }
  ],
  "env": {
    "VERCEL": "1"
  }
}
