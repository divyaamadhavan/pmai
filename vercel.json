{
  "version": 2,
  "builds": [
    {
      "src": "app/backend/api/index.ts",
      "use": "@vercel/node",
      "config": {
        "bundle": false,
        "includeFiles": [
          "app/frontend/dist/**/*",
          "app/backend/src/db/schema.sql"
        ]
      }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "/app/backend/api/index.ts" }
  ],
  "env": {
    "VERCEL": "1"
  }
}
